# The Wait - environment.
# Copy to .env and fill in, or set these in your host's dashboard.

# Required. Any Postgres: Neon, Supabase, RDS, or a local container.
DATABASE_URL=postgres://thewait:thewait@127.0.0.1:55432/thewait

# TLS is decided from DATABASE_URL - off for localhost, on for anything else.
# Set explicitly only if that guess is wrong for your host.
# DATABASE_SSL=true

# Connections per instance. Several instances share your database's limit,
# so lower this if you run many of them.
# DB_POOL_SIZE=10

# HTTP. Most hosts set PORT for you.
# PORT=8080
# HOST=0.0.0.0

# Tests truncate every table, so point this at a throwaway database.
# TEST_DATABASE_URL=postgres://thewait:thewait@127.0.0.1:55432/thewait_test
